---
import IconSvg from "../IconSvg.astro";
---

<section class="_hero-features bg-surface-secondary-inverse shadow-[0px_24px_54px_0px_hsla(237,92%,67%,0.3)]" data-cmp="HeroFeatures">
  <div class="container">
    <div
      class="_features-inner grid grid-cols-[6fr_5fr] lg:grid-cols-[3fr_5fr] gap-8 lg:gap-20 py-7.5 lg:py-12.5 max-w-[min(1300px,100%)] mx-auto text-text-primary-inverse"
    >
      <h3 class="max-w-[344px] typo-h3 balance">Лучший сервис для вашего бизнеса</h3>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div>
          <IconSvg size={50} name="doc-duo" />
          <p class="mt-4 balance typo-t2">
            Работаем
            <br />
            по договору
          </p>
        </div>
        <div>
          <IconSvg size={50} name="card" />
          <p class="mt-4 balance typo-t2">
            Рассрочка при
            <br />
            крупных заказах
          </p>
        </div>
        <div>
          <IconSvg size={50} name="24" />
          <p class="mt-4 balance typo-t2">
            Обслуживание
            <br />
            24/7
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
