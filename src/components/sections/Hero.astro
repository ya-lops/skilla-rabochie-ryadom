---
import Button from "@/components/ui/Button.astro";

import HeroFeatures from "../blocks/HeroFeatures.astro";
import IconSvg from "../IconSvg.astro";

interface Props {
  brandData: any;
  type: "main" | "about";
}

const { brandData, type = "main" } = Astro.props;

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

{
  type == "main" && (
    <>
      <section
        class="hero grid grid-cols-[100%] min-h-[730px] bg-hero-main-surface text-hero-main-text overflow-clip isolate"
        data-cmp="Hero"
      >
        <div class="container h-full">
          <div class="_hero-inner relative grid grid-cols-1 lg:grid-cols-2 items-start lg:items-center h-full py-8">
            <div class="_hero-content flex flex-col gap-10">
              <div class="flex gap-2.5 items-center">
                <IconSvg name="location" size={24} />
                <span>Москва</span>
              </div>

              <h1 class="_hero-title typo-h1 text-left text-balance">Закажи услуги грузчиков и разнорабочих</h1>

              <p class="text-accent typo-h4">прямо сейчас со скидкой {brandData.main.adv_price_percent}%</p>

              <div class="_hero-actions flex flex-col lg:flex-row items-start lg:items-center gap-6 lg:gap-8">
                <div class="_hero-actions-items">
                  <Button href="#contact" variant="accent" text="Получить КП" />
                </div>
              </div>
            </div>
            <div class="_hero-image">
              <img class="scale-200 md:scale-125 lg:scale-none" src="/images/hero-main.webp" alt="" fetchpriority="high" />
            </div>
          </div>
        </div>
      </section>

      <HeroFeatures />
    </>
  )
}

{
  type == "about" && (
    <>
      <section
        class="hero grid grid-cols-[100%] min-h-[730px] bg-hero-about-surface text-hero-about-text overflow-clip isolate"
        data-cmp="Hero"
      >
        <div class="container h-full">
          <div class="_hero-inner relative grid grid-cols-1 lg:grid-cols-2 items-start lg:items-center h-full py-8">
            <div class="_hero-content flex flex-col gap-10">
              <div class="flex gap-2.5 items-center">
                <IconSvg name="location" size={24} />
                <span>Москва</span>
              </div>

              <h1 class="_hero-title typo-h1 text-left text-balance">Успешно оказываем услуги 15 лет</h1>

              <p class="text-accent typo-h4">прямо сейчас со скидкой {brandData.main.adv_price_percent}%</p>

              <div class="_hero-actions flex items-center gap-8">
                <div class="_hero-actions-items">
                  <Button href={`/${firstServiceUrl}`} variant="secondary" text="Наши услуги" arrow="right" />
                </div>
              </div>
            </div>

            <div class="_hero-image">
              <img src="/images/hero-about.webp" alt="" fetchpriority="high" />
            </div>
          </div>
        </div>
      </section>

      <HeroFeatures />
    </>
  )
}
