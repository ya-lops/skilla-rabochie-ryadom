---
import Button from "@/components/ui/Button.astro";

import HeroFeatures from "../blocks/HeroFeatures.astro";
import IconSvg from "../IconSvg.astro";

interface Props {
  brandData: any;
  type: "main" | "about";
}

const { brandData, type = "main" } = Astro.props;

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

{
  type == "main" && (
    <>
      <section
        class="hero grid grid-cols-[100%] min-h-[500px] lg:min-h-[630px] bg-hero-main-surface text-hero-main-text overflow-clip isolate"
        data-cmp="Hero"
      >
        <div class="container h-full">
          <div class="_hero-inner relative grid grid-cols-1 lg:grid-cols-[2fr_100px_2fr] items-start lg:items-center h-full ">
            <div class="_hero-content flex flex-col gap-5 lg:gap-10 py-8 lg:col-start-1 lg:row-start-1 col-span-1">
              <div class="flex gap-2.5 items-center">
                <IconSvg name="location" size={24} />
                <span>Москва</span>
              </div>

              <h1 class="_hero-title typo-h1 text-left text-balance">Надежные исполнители для вашего бизнеса</h1>

              <p class="text-accent typo-h4">Оперативный вывод на объект без кадровой рутины</p>

              <div class="_hero-actions flex flex-col lg:flex-row items-start lg:items-center gap-6 lg:gap-8">
                <div class="_hero-actions-items">
                  <Button href="#kp" variant="accent" text="Получить КП" />
                </div>
              </div>
            </div>
            <div class="_hero-image self-end lg:col-start-2 lg:row-start-1 col-span-2">
              <img class="pointer-events-none" src="/images/hero-main.webp" alt="" fetchpriority="high" />
            </div>
          </div>
        </div>
      </section>

      <HeroFeatures />
    </>
  )
}

{
  type == "about" && (
    <>
      <section
        class="hero grid grid-cols-[100%] min-h-[630px] bg-hero-about-surface text-hero-about-text overflow-clip isolate"
        data-cmp="Hero"
      >
        <div class="container h-full">
          <div class="_hero-inner relative grid grid-cols-1 lg:grid-cols-2 items-start lg:items-center h-full ">
            <div class="_hero-content flex flex-col gap-5 lg:gap-10 py-8">
              <div class="flex gap-2.5 items-center">
                <IconSvg name="location" size={24} />
                <span>Москва</span>
              </div>

              <h1 class="_hero-title typo-h1 text-left text-balance">14 000<br>ответственных исполнителей</h1>

              <p class="text-accent typo-h4">готовых взяться за выполнение вашей задачи</p>

              <div class="_hero-actions flex items-center gap-8">
                <div class="_hero-actions-items">
                  <Button href={`/${firstServiceUrl}`} variant="secondary" text="Наши услуги" arrow="right" />
                </div>
              </div>
            </div>

            <div class="_hero-image self-end">
              <img src="/images/hero-about.webp" alt="" fetchpriority="high" />
            </div>
          </div>
        </div>
      </section>

      <HeroFeatures />
    </>
  )
}
