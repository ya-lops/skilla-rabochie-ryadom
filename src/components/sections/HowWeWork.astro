---
import type { BrandData } from "@/types/brand";
import IconSvg from "../IconSvg.astro";

interface Props {
  brandData: BrandData;
  type: "cards" | "timeline" | "flow";
}

const { brandData, type = "cards" } = Astro.props;

const steps = [
  {
    title: "Делайте заказ по телефону",
    image: "phone-duo",
  },
  {
    title: "Выставляем счет и вы оплачиваете",
    image: "price-duo",
  },
  {
    title: "Выполняем качественно работу",
    image: "box-duo",
  },
  {
    title: "Вы получаете документы",
    image: "doc-duo",
  },
];
---

<section class="how-we-work py-8 md:py-10 lg:py-20" data-cmp="HowWeWork">
  <div class="container">
    <h2 class="_how-we-work-title pb-16 text-text-primary">Как мы работаем</h2>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      {
        steps.map((step: any, index: number) => (
          <div class="relative flex lg:flex-col items-center lg:items-start gap-2 lg:gap-7 p-8 rounded-xl bg-surface-secondary-inverse overflow-clip isolate text-text-primary-inverse shadow-[0px_24px_54px_0px_hsla(237,92%,67%,0.3)]">
            <div class="_content ">
              <div class="_number mb-6 text-left typo-h3">{index + 1}.</div>
              <h3 class="_title typo-t1 text-left balance">{step.title}</h3>
            </div>
            <div class="flex shrink-0">
              <IconSvg name={step.image} size={90} />
            </div>
            <div class="_decorative absolute -z-1 left-[80%] lg:left-[60%] top-[-40%] lg:top-[60%] w-[max(33%,170px)] lg:w-[max(33%,270px)] aspect-square border-47 lg:border-54 border-surface-primary-inverse rounded-full" />
          </div>
        ))
      }
    </div>
  </div>
</section>
