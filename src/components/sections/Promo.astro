---
import type { BrandData } from "@/types/brand";
import Button from "../ui/Button.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const discount = brandData.main.adv_price_percent;

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

<section class="promo bg-promo-surface overflow-clip" data-cmp="Promo">
  <div class="container">
    <div class="_promo-inner flex items-center justify-between gap-2 max-w-[500px] mx-auto">
      <div class="flex items-center gap-4">
        <div
          class="py-1 px-2 text-text-primary-inverse font-bold text-[12px] lg:text-[13px] rounded-xl bg-button-primary-surface shadow-[0px_15.18px_27.83px_0px_hsla(237,92%,67%,0.3)]"
        >
          -{discount}%
        </div>
        <div class="_promo-description flex flex-col">
          <p class="text-promo-text-primary text-md font-bold">Только в сентябре</p>
          <p class="text-promo-text-secondary typo-t4 font-medium">скидка {discount}% на все услуги</p>
        </div>
      </div>
      <div class="_promo-actions py-2">
        <Button href={`/${firstServiceUrl}`} class="!h-[38px]" variant="secondary" text="В каталог" />
      </div>
    </div>
  </div>
</section>
